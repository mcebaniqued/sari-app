{
  "name": "sari-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/contracts",
    "api",
    "web"
  ],
  "engines": {
    "node": ">=24 <27",
    "npm": ">=11"
  },
  "scripts": {
    "contracts:build": "npm run build -w @sari/contracts",
    "predev": "npm run contracts:build",
    "dev": "concurrently --kill-others --names contracts,api,web \"npm run dev -w @sari/contracts\" \"npm run dev -w @sari/api\" \"npm run dev -w @sari/web\"",
    "build": "npm run build --workspaces",
    "start": "npm run start -w @sari/api",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretypecheck": "npm run contracts:build",
    "typecheck": "npm run typecheck --workspaces",
    "pretest": "npm run contracts:build",
    "test": "npm run test --workspaces --if-present",
    "pretest:coverage": "npm run contracts:build",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "pretest:e2e": "npm run contracts:build",
    "test:e2e": "playwright test",
    "knip": "knip",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run knip && npm run test && npm run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "knip": "^6.42.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,yaml,yml,md,css,html}": "prettier --write"
  }
}
