PORT=3001
# Use a fresh database. Replace this URI with Atlas credentials when ready.
MONGODB_URI=mongodb://127.0.0.1:27017/sari_mvp1
# Browser origin, including the port locally. Use your HTTPS frontend URL in production.
BETTER_AUTH_URL=http://127.0.0.1:5173
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=
# Local development also permits localhost on the same port as 127.0.0.1 (and vice versa).
# Optional extra exact browser origins, comma-separated. No wildcards.
AUTH_TRUSTED_ORIGINS=
