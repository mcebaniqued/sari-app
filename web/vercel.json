{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "HUSKY=0 npm ci --include=dev --workspaces --include-workspace-root",
  "buildCommand": "npm run build -w @sari/contracts && npm run build",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://sari-api.vercel.app/api/v1/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
