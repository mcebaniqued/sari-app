{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/verify-atlas-restore.mjs"]
    },
    "packages/contracts": {
      "project": ["src/**/*.ts"]
    },
    "api": {
      "entry": ["src/app.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "web": {
      "entry": ["src/test/ModalBrowserFixture.tsx"],
      "project": ["src/**/*.{ts,tsx,css}", "*.config.ts"]
    }
  }
}
